# Makefile for building the parser and test program.

GHC        = ghc
HAPPY      = happy
HAPPY_OPTS = --array --info --ghc --coerce
ALEX       = alex
ALEX_OPTS  = --ghc

# List of goals not corresponding to file names.

.PHONY : all clean distclean

# Default goal.

all : Prova/Test

# Rules for building the parser.

Prova/Abs.hs Prova/Lex.x Prova/Par.y Prova/Print.hs Prova/Test.hs : prova.cf
	bnfc --haskell -d prova.cf

%.hs : %.y
	${HAPPY} ${HAPPY_OPTS} $<

%.hs : %.x
	${ALEX} ${ALEX_OPTS} $<

Prova/Test : Prova/Abs.hs Prova/Lex.hs Prova/Par.hs Prova/Print.hs Prova/Test.hs
	${GHC} ${GHC_OPTS} $@

# Rules for cleaning generated files.

clean :
	-rm -f Prova/*.hi Prova/*.o Prova/*.log Prova/*.aux Prova/*.dvi

distclean : clean
	-rm -f Prova/Abs.hs Prova/Abs.hs.bak Prova/ComposOp.hs Prova/ComposOp.hs.bak Prova/Doc.txt Prova/Doc.txt.bak Prova/ErrM.hs Prova/ErrM.hs.bak Prova/Layout.hs Prova/Layout.hs.bak Prova/Lex.x Prova/Lex.x.bak Prova/Par.y Prova/Par.y.bak Prova/Print.hs Prova/Print.hs.bak Prova/Skel.hs Prova/Skel.hs.bak Prova/Test.hs Prova/Test.hs.bak Prova/XML.hs Prova/XML.hs.bak Prova/AST.agda Prova/AST.agda.bak Prova/Parser.agda Prova/Parser.agda.bak Prova/IOLib.agda Prova/IOLib.agda.bak Prova/Main.agda Prova/Main.agda.bak Prova/prova.dtd Prova/prova.dtd.bak Prova/Test Prova/Lex.hs Prova/Par.hs Prova/Par.info Prova/ParData.hs Makefile
	-rmdir -p Prova/

