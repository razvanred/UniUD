
-- commenti singola linea
comment "#" ;
--commenti multiLine?
 
-- un programma è una sequenza di dichiarazioni
Prog.       Program ::= [Decl] ;
separator   Decl "§" ;

-- dichiarazione di costante
ConstDecl.  Decl ::= "def" Ident ":" Type ":=" RExpr ; 

-- dichiarazione di variabile
VarDecl.    Decl ::= "var" Ident ":" Type ":=" RExpr ; -- TODO1

-- dichiarazione di procedura o funzione
FunDecl.    Decl ::= "def" Ident "(" [Parameter] ")" ":" Type Block ;
separator Parameter "," ;
Param.      Parameter ::= Ident ":" Type ;

-- un tipo può essere tipo semplice
BasType.    Type ::= BasicType ;
rules BasicType ::= "bool" | "char" | "int" | "string" | "float" | "void" ;
rules Boolean ::= "True" | "False" ;

-- oppure tipo composto
CompType.      Type ::= CompoundType ; -- TODO3
ArrDef.        CompoundType ::= "[" RExpr "]" Type ;
ArrPartialDef. CompoundType ::= "["  "]" Type ;
Pointer.       CompoundType ::= "&" Type ;

BlockDecl.  Block ::= "{" [Decl] [Statement] "}" ;
separator Statement "§" ;

Comp.       Statement ::= Block ;
-- ProcCall.   Statement ::= FunCall ;
Jmp.        Statement ::= JumpStatement  ;
Iter.       Statement ::= IterStatement ;
Sel.        Statement ::= SelectionStatement ;
Assgn.      Statement ::= LExpr Assignment_op RExpr ;
LExprStatement.  Statement ::= LExpr ;

Assign.     Assignment_op ::= ":=" ;
AssgnMul.   Assignment_op ::= "*=" ;
AssgnAdd.   Assignment_op ::= "+=" ;
AssgnDiv.   Assignment_op ::= "/=" ;
AssgnSub.   Assignment_op ::= "-=" ;
AssgnPow.   Assignment_op ::= "^=" ;
AssgnAnd.   Assignment_op ::= "&=" ;
AssgnOr.    Assignment_op ::= "|=" ;

Break.      JumpStatement ::= "break" ;
Continue.   JumpStatement ::= "continue" ;
RetExpVoid. JumpStatement ::= "return" ;
RetExp.     JumpStatement ::= "return" "(" RExpr ")" ;

IfNoElse.   SelectionStatement ::= "if" "(" RExpr ")" Block ;
IfElse.     SelectionStatement ::= "if" "(" RExpr ")" Block "else" Block ;

While.      IterStatement ::= "while" "(" RExpr ")" Block ;

coercions   RExpr 14 ;

Or.         RExpr  ::= RExpr "||" RExpr1 ;
And.        RExpr1 ::= RExpr1 "&&" RExpr2 ;
Not.        RExpr2 ::= "!" RExpr3 ;

Eq.         RExpr5 ::= RExpr6 "==" RExpr6 ;
Neq.        RExpr5 ::= RExpr6 "!=" RExpr6 ;
Lt.         RExpr5 ::= RExpr6 "<"  RExpr6 ;
LtE.        RExpr5 ::= RExpr6 "<=" RExpr6 ;
Gt.         RExpr5 ::= RExpr6 ">"  RExpr6 ;
GtE.        RExpr5 ::= RExpr6 ">=" RExpr6 ;

Add.        RExpr7 ::= RExpr7 "+" RExpr8 ;
Sub.        RExpr7 ::= RExpr7 "-" RExpr8 ;

Mul.        RExpr8 ::= RExpr8 "*" RExpr9 ;
Div.        RExpr8 ::= RExpr8 "/" RExpr9 ;
Mod.        RExpr8 ::= RExpr8 "%" RExpr9 ;

Pow.        RExpr9 ::= RExpr10 "**" RExpr9 ;

Neg.        RExpr11 ::= "-" RExpr12 ;
Ref.        RExpr11 ::= "&" LExpr ;

--FCall.      RExpr12 ::= FunCall ;

Int.        RExpr13 ::= Integer ;
Char.       RExpr13 ::= Char ;
String.     RExpr13 ::= String ;
Float.      RExpr13 ::= Double ;
Bool.       RExpr13 ::= Boolean ;

_.          RExpr13 ::= RExpr14 ;
Array.      RExpr14 ::= "[" [RExpr13] "]" ;
separator RExpr13 "," ;

Lexpr.      RExpr15 ::= LExpr ;
Increment.  RExpr16 ::= Incr ;

-- ++a++
PreInc.     Incr ::= "++" BLExpr ;
PreDecr.    Incr ::= "--" BLExpr ;

PostInc.    Incr ::= BLExpr "++" ;
PostDecr.   Incr ::= BLExpr "--" ;

Deref.      LExpr ::= "$" RExpr ;
BasLExpr.   LExpr2 ::= BLExpr ;

ArrayEl.    BLExpr ::= BLExpr "[" RExpr "]" ;
Id.         BLExpr ::= Ident ;