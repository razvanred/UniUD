-- commenti singola linea
comment "#" ;
comment "#<" ">#" ;

entrypoints SBlock1;

-- un blocco è una sequenza di istruzioni
_.           SBlock ::= "{" SBlock1 "}" ;
Block.       SBlock1 ::= [ Instruction ];
-- un'istruzione è una dichiarazione o uno statement
Statement.    Instruction ::= SStatement;
Declaration.  Instruction ::= SDeclaration;
separator Instruction ";";

-- dichiarazione di costante
ConstDecl.  SDeclaration ::= "def" Ident ":" Type ":=" Expr ; 

-- dichiarazione di variabile
VarDecl.    SDeclaration ::= "var" Ident ":" Type ":=" Expr ;

-- dichiarazione di procedura o funzione
FunDecl.    SDeclaration ::= "def" Ident "(" [Parameter] ")" ":" Type SBlock ;
separator   Parameter "," ;
Param.      Parameter ::= Modality Ident ":" Type ;
-- | "const" | "res" | "valres" | "name"
rules  Modality ::= {-empty-} | "val" | "ref" ; 

-- sintassi tipi
BasicType.         Type ::= SBasicType ;
ArrayType.         Type ::= "[" Expr "]" Type ;
UnsizedArrayType.  Type ::= "["  "]" Type ;
Pointer.           Type ::= "&" Type ;
rules SBasicType ::= "bool" | "char" | "int" | "string" | "float" | "void" ;

-- statements

Compound.   SStatement ::= SBlock ;
ProcCall.   SStatement ::= FunCall ;
Jump.       SStatement ::= JumpSStatement  ;
Iter.       SStatement ::= IterSStatement ;
Branch.     SStatement ::= BranchSStatement ;
Assign.     SStatement ::= Expr Assignment_op Expr ;

_.          SStatement ::= SStatement1 ;


AssignOp.   Assignment_op ::= ":=" ;
AssignMul.  Assignment_op ::= "*=" ;
AssignAdd.  Assignment_op ::= "+=" ;
AssignDiv.  Assignment_op ::= "/=" ;
AssignSub.  Assignment_op ::= "-=" ;
AssignPow.  Assignment_op ::= "^=" ;
AssignAnd.  Assignment_op ::= "&=" ;
AssignOr.   Assignment_op ::= "|=" ;

Break.      JumpSStatement ::= "break" ;
Continue.   JumpSStatement ::= "continue" ;
RetExpVoid. JumpSStatement ::= "return" ;
RetExp.     JumpSStatement ::= "return" Expr ;

IfNoElse.   BranchSStatement ::= "if" "(" Expr ")" SBlock ;
IfElse.     BranchSStatement ::= "if" "(" Expr ")" SBlock "else" SBlock ;

While.      IterSStatement ::= "while" "(" Expr ")" SBlock ;

Or.         Expr  ::= Expr "||" Expr1 ;
And.        Expr1 ::= Expr1 "&&" Expr2 ;
Not.        Expr2 ::= "!" Expr3 ;

Eq.         Expr3 ::= Expr4 "==" Expr4 ;
Neq.        Expr3 ::= Expr4 "!=" Expr4 ;
Lt.         Expr3 ::= Expr4 "<"  Expr4 ;
LtE.        Expr3 ::= Expr4 "<=" Expr4 ;
Gt.         Expr3 ::= Expr4 ">"  Expr4 ;
GtE.        Expr3 ::= Expr4 ">=" Expr4 ;

Add.        Expr4 ::= Expr4 "+" Expr5 ;
Sub.        Expr4 ::= Expr4 "-" Expr5 ;

Mul.        Expr5 ::= Expr5 "*" Expr6 ;
Div.        Expr5 ::= Expr5 "/" Expr6 ;
Mod.        Expr5 ::= Expr5 "%" Expr6 ;

Pow.        Expr6 ::= Expr7 "**" Expr6 ;

Neg.        Expr7 ::= "-" Expr8 ;

Ref.        Expr8 ::= "&" Expr8 ;
Deref.      Expr8 ::= "$" Expr8 ;

ArrayAcc.   Expr8 ::= Expr8 "[" Expr "]";

Id.         Expr9 ::= Ident ;
ExpAssign.  Expr9 ::= SStatement1 ;

FCall.      Expr10 ::= FunCall ;

Int.        Expr11 ::= Integer ;
Char.       Expr11 ::= Char ;
-- NumChar.    Expr11 ::= Integer 'f' <-- da Lexer
String.     Expr11 ::= String ;
Float.      Expr11 ::= Double ;
Bool.       Expr11 ::= Boolean ;
rules Boolean ::= "True" | "False" ;


Array.        Expr12 ::= "[" [Expr11] "]" ;
separator nonempty Expr11 "," ;
RangedArray.  Expr12 ::= "[" Expr11 "..." Expr11 "]" ;

coercions Expr 12 ;

-- increment handling
PreInc.     SStatement1 ::= "++" Expr8 ;
PreDecr.    SStatement1 ::= "--" Expr8 ;
PostInc.    SStatement1 ::= Expr8 "++" ;
PostDecr.   SStatement1 ::= Expr8 "--" ;

Call.       FunCall ::= Ident "(" [Expr] ")" ;
separator   Expr "," ;

{- Or.         Expr  ::= Expr "||" Expr1 ;
And.        Expr1 ::= Expr1 "&&" Expr2 ;
Not.        Expr2 ::= "!" Expr3 ;

Eq.         Expr3 ::= Expr4 "==" Expr4 ;
Neq.        Expr3 ::= Expr4 "!=" Expr4 ;
Lt.         Expr3 ::= Expr4 "<"  Expr4 ;
LtE.        Expr3 ::= Expr4 "<=" Expr4 ;
Gt.         Expr3 ::= Expr4 ">"  Expr4 ;
GtE.        Expr3 ::= Expr4 ">=" Expr4 ;

Add.        Expr4 ::= Expr4 "+" Expr5 ;
Sub.        Expr4 ::= Expr4 "-" Expr5 ;

Mul.        Expr5 ::= Expr5 "*" Expr6 ;
Div.        Expr5 ::= Expr5 "/" Expr6 ;
Mod.        Expr5 ::= Expr5 "%" Expr6 ;

Pow.        Expr6 ::= Expr7 "**" Expr6 ;

Neg.        Expr7 ::= "-" Expr8 ;
Ref.        Expr7 ::= "&" Expr7 ;
Deref.      Expr7 ::= "$" Expr7 ;
ArrayEl.    Expr7 ::= "[" Expr "]" Expr7 ;

Id.         Expr8 ::= Ident ;
Increment.  Expr8 ::= SStatement1 ;

FCall.      Expr9 ::= FunCall ;

Int.        Expr10 ::= Integer ;
Char.       Expr10 ::= Char ;
String.     Expr10 ::= String ;
Float.      Expr10 ::= Double ;
Bool.       Expr10 ::= Boolean ;
rules Boolean ::= "True" | "False" ;

Array.      Expr11 ::= "[" [Expr10] "]" ;
separator nonempty Expr10 "," ; -}
